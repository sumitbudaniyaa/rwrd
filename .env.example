# TipTable Monorepo Root Environment Configuration
# DO NOT COMMIT ACTUAL SECRETS. Copy this file to .env for local Docker/development.

# Environment
NODE_ENV=development
API_BASE_URL=http://localhost:4000
PORT=4000

# PostgreSQL 16 (matches docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tiptable_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tiptable_dev
POSTGRES_PORT=5432

# Redis 7 (matches docker-compose.yml)
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# MinIO Local Object Storage (matches docker-compose.yml)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=tiptable-media
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Security & Encryption (32-byte hex for AES-256-GCM)
VPA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
VPA_ENCRYPTION_KEY_PREV=

# JWT Secrets (Minimum 32 characters, dummy values)
ADMIN_JWT_SECRET=dummy_admin_access_token_secret_min_32_chars!
ADMIN_JWT_EXPIRES_IN=15m
ADMIN_REFRESH_SECRET=dummy_admin_refresh_token_secret_min_32_chars!
ADMIN_REFRESH_EXPIRES_IN=7d

PORTAL_JWT_SECRET=dummy_portal_access_token_secret_min_32_chars!
PORTAL_JWT_EXPIRES_IN=15m
PORTAL_REFRESH_SECRET=dummy_portal_refresh_token_secret_min_32_chars!
PORTAL_REFRESH_EXPIRES_IN=24h

# CORS & Network
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
TRUST_PROXY=1
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_GLOBAL_MAX=1000
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=100
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_INTENT_MAX=10
RATE_LIMIT_INTENT_WINDOW_MS=60000

# Client Application URLs
CUSTOMER_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3001
PORTAL_APP_URL=http://localhost:3002
LANDING_APP_URL=http://localhost:3003

