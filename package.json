{
  "name": "tiptable-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter \"@tiptable/*\" --parallel dev",
    "build": "pnpm --filter \"@tiptable/*\" --if-present --recursive build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm --filter \"@tiptable/*\" --if-present --recursive typecheck",
    "test": "pnpm --filter \"@tiptable/*\" --if-present --recursive test",
    "test:e2e": "playwright test",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "db:migrate": "pnpm --filter @tiptable/api db:migrate",
    "db:generate": "pnpm --filter @tiptable/api db:generate",
    "db:seed": "pnpm --filter @tiptable/api db:seed",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3"
  }
}
