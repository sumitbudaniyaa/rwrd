# Node & Server
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

# Database & Cache
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tiptable_dev
REDIS_URL=redis://localhost:6379

# Network & Security
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
TRUST_PROXY=1
LOG_LEVEL=info

# JWT Secrets (Minimum 32 characters, dummy values)
ADMIN_JWT_SECRET=dummy_admin_jwt_secret_must_be_at_least_32_characters_long!
ADMIN_JWT_EXPIRES_IN=15m
ADMIN_REFRESH_SECRET=dummy_admin_refresh_secret_at_least_32_chars!
ADMIN_REFRESH_EXPIRES_IN=7d

PORTAL_JWT_SECRET=dummy_portal_jwt_secret_must_be_at_least_32_chars!
PORTAL_JWT_EXPIRES_IN=15m
PORTAL_REFRESH_SECRET=dummy_portal_refresh_secret_at_least_32_chars!
PORTAL_REFRESH_EXPIRES_IN=24h

# Encryption Keys (32-byte hex for AES-256-GCM)
VPA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
VPA_ENCRYPTION_KEY_PREV=

# S3 / MinIO Object Storage
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=tiptable-media
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Rate Limiting
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_INTENT_MAX=10
RATE_LIMIT_INTENT_WINDOW_MS=60000

# Optional integrations
TURNSTILE_SECRET_KEY=
PORTAL_ALLOWED_IPS=
SENTRY_DSN=

